<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CourierListWindow" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <pl:ConvertVehicleTypeToColor x:Key="VehicleColorConverter"/>
        <pl:ConvertDeleteToColor x:Key="DeleteColorConverter"/>
        <pl:ConvertDeleteToEnabled x:Key="DeleteEnabledConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DarkBlueBrush}" 
        BorderThickness="0,0,0,1" BorderBrush="LightGray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Couriers Filter ->" Grid.Column="0" 
                       Style="{StaticResource StandardLabel}"/>

                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Margin="0" Height="30"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  FontWeight="Bold" FontSize="16" Foreground="Red" 
                  ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionKey}}" 
                  SelectedValue="{Binding VehicleFilter, Mode=TwoWay}" 
                  SelectionChanged="CourierFilter_SelectionChanged"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="CourierDataGrid"
                  ItemsSource="{Binding CourierList}"
                  SelectedItem="{Binding SelectedCourier}"
                  Style="{StaticResource StandardDataGridStyle}"
                  MouseDoubleClick="CourierDataGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CourierId}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding CourierFullName}" Width="*"/>
                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleType}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" 
                            Value="{Binding VehicleType, Converter={StaticResource VehicleColorConverter}}"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding CourierIsActive}" Width="*"/>
                <DataGridTextColumn Header="On Time" Binding="{Binding DeliveriesInTime}" Width="*"/>
                <DataGridTextColumn Header="Late" Binding="{Binding DeliveriesOverTime}" Width="*"/>
                <DataGridTextColumn Header="Current Order" Binding="{Binding OrderIdInHandle}" Width="*"/>

                <DataGridTextColumn Header="Since" Binding="{Binding StartWorkDate, StringFormat=dd/MM/yyyy}" Width="*"/>

                <DataGridTemplateColumn Header="Delete" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️" 
                                    Click="BtnDelete_Click"
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    FontSize="16" 
                                    Cursor="Hand" 
                                    ToolTip="Delete Item"
                                    Foreground="{Binding Converter={StaticResource DeleteColorConverter}}"
                                    IsEnabled="{Binding Converter={StaticResource DeleteEnabledConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource DarkBlueBrush}">
            <Button Content="Add" Grid.Row="2"
                    Style="{StaticResource ActionButtonStyle}"
                    FontSize="16" Click="BtnAdd_Click"
                    Margin="0"/>
        </Border>
    </Grid>
</Window>