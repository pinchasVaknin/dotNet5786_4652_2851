<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CourierListWindow" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    
    <Window.Resources>
        <pl:ConvertVehicleTypeToColor x:Key="VehicleColorConverter"/>
        <pl:ConvertDeleteToColor x:Key="DeleteColorConverter"/>
        <pl:ConvertDeleteToEnabled x:Key="DeleteEnabledConverter"/>
    </Window.Resources>
    
    <!--External Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Internal, Upper Grid-->
        <Border Grid.Row="0" Background="LightGray" BorderThickness="0,0,0,1">
            <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Couriers Filter ->" Grid.Column="0" FontSize="26"
                       Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      FontWeight="Bold" FontSize="16" Foreground="Red" 
                      ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionKey}}" 
                      SelectedValue="{Binding VehicleFilter, Mode=TwoWay}" SelectionChanged="CourierFilter_SelectionChanged"/>

            </Grid>
        </Border>
        <DataGrid Margin="5" Grid.Row="1"  
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  FontWeight="Bold" AutoGenerateColumns="False" IsReadOnly="True"
                  x:Name="CourierDataGrid"
                  ItemsSource="{Binding CourierList}"
                  SelectedItem="{Binding SelectedCourier}"
                  MouseDoubleClick="CourierDataGrid_MouseDoubleClick">

            <!--Align to the center of the data-->
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <!--Align to the center of the title-->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CourierId}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding CourierFullName}" Width="*"/>
                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleType}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" 
                            Value="{Binding VehicleType, Converter={StaticResource VehicleColorConverter}}"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding CourierIsActive}" Width="*"/>
                <DataGridTextColumn Header="On Time" Binding="{Binding DeliveriesInTime}" Width="*"/>
                <DataGridTextColumn Header="Late" Binding="{Binding DeliveriesOverTime}" Width="*"/>
                <DataGridTextColumn Header="Current Order" Binding="{Binding OrderIdInHandle}" Width="*"/>
                <DataGridTextColumn Header="Since" Binding="{Binding StartWorkDate, StringFormat=d}" Width="*"/>

                <!--Delete-->
                <DataGridTemplateColumn Header="Delete" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️" 
                                    Click="BtnDelete_Click"
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    FontSize="16" 
                                    Cursor="Hand" 
                                    ToolTip="Delete Item"
                                    Foreground="{Binding Converter={StaticResource DeleteColorConverter}}"
                                    IsEnabled="{Binding Converter={StaticResource DeleteEnabledConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
            </DataGrid.Columns>

            

        </DataGrid>


        <Border Grid.Row="2" Background="#2C3E50">
            <Button Content="Add" Grid.Row="2" 
                    HorizontalAlignment="Center" 
                    Height="50" Width="100" 
                    Background="#27AE60" 
                    Foreground="White" 
                    FontSize="16" Click="BtnAdd_Click"/>
        </Border>
    </Grid>

</Window>
