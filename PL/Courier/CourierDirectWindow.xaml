<Window x:Class="PL.Courier.CourierDirectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="700" Width="1000"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <TextBlock Text="COURIER" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="20" FontWeight="Light"/>
                    <TextBlock Text="PORTAL" Foreground="White" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
                    <Separator Margin="20,10" Opacity="0.3"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Current Status:" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <Border x:Name="StatusBadge" CornerRadius="10" Background="Gray" Padding="15,5" Margin="0,5">
                        <TextBlock x:Name="txtStatus" Text="Loading..." Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Content="Logout" Style="{StaticResource ActionButtonStyle}" 
                        Background="#E74C3C" Margin="20" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="My Profile &amp; Statistics" Foreground="#3498DB" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="ID:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCourier.CourierId, Mode=OneWay}" IsReadOnly="True" Background="#EEE" Style="{StaticResource NumericStyle}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Full Name:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCourier.CourierFullName, Mode=TwoWay}" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Phone:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCourier.CourierCellPhone, Mode=TwoWay}" Style="{StaticResource NumericStyle}"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Email:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCourier.CourierEmail, Mode=TwoWay}" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="Password:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCourier.CourierPassword, Mode=TwoWay}" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="Start Date:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCourier.StartWorkDate, StringFormat=d, Mode=OneWay}" IsReadOnly="True" Background="#EEE" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="0" Grid.Column="3" Content="Active User:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding CurrentCourier.CourierIsActive, Mode=OneWay}" IsReadOnly="True" Background="#EEE" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="1" Grid.Column="3" Content="Location:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CurrentCourier.CourierLocation, Mode=OneWay}" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="2" Grid.Column="3" Content="Max Distance:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding CurrentCourier.MaxCourierDistance, Mode=TwoWay}" Style="{StaticResource NumericStyle}"/>

                            <Label Grid.Row="3" Grid.Column="3" Content="Vehicle Type:" Style="{StaticResource ConfigLabelStyle}"/>
                            <ComboBox x:Name="cmbVehicle" Grid.Row="3" Grid.Column="4" 
                                      ItemsSource="{Binding VehicleTypesList}"
                                      SelectedItem="{Binding CurrentCourier.VehicleType, Mode=TwoWay}"
                                      Style="{StaticResource ConfigComboBoxStyle}"/>

                            <Label Grid.Row="4" Grid.Column="3" Content="On-Time Deliveries:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding CurrentCourier.TotalOnTimeDeliveries, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold" Foreground="Green" Style="{StaticResource ConfigTextBoxStyle}"/>

                            <Label Grid.Row="5" Grid.Column="3" Content="Late Deliveries:" Style="{StaticResource ConfigLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding CurrentCourier.TotalLateDeliveries, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold" Foreground="Red" Style="{StaticResource ConfigTextBoxStyle}"/>

                        </Grid>
                    </StackPanel>
                </Border>

                <Button Grid.Row="1" Content="Update Profile" Width="200" Margin="0,15" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButtonStyle}" Click="BtnUpdate_Click"/>

                <Grid Grid.Row="2" Margin="0,20,0,0">

                    <Border x:Name="pnlNoOrder" Background="#F9F9F9" BorderBrush="Gray" BorderThickness="1,1,1,1" CornerRadius="10" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Ready for next mission?" FontSize="20" Foreground="Gray" Margin="0,0,0,20"/>
                            <Button Content="Pick New Order" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Click="BtnPickOrder_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="pnlHasOrder" Background="#FFF8E1" BorderBrush="#F39C12" BorderThickness="2" CornerRadius="10" Padding="20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚠ ACTIVE DELIVERY IN PROGRESS" Foreground="#E67E22" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Delivery ID:" FontWeight="Bold"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.DeliveryId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Order ID:" FontWeight="Bold"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.OrderId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Type:" FontWeight="Bold"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.TypeOfOrder, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="Details:" FontWeight="Bold"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.OrderDetail, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="Customer Name:" FontWeight="Bold"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.CostumerFullName, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="Address:" FontWeight="Bold"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.CustomerAddress, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="6" Grid.Column="0" Content="Phone:" FontWeight="Bold"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.CostumerPhone, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="7" Grid.Column="0" Content="Status:" FontWeight="Bold"/>
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentCourier.OrderInProgress.OrderStatus, Mode=OneWay}" IsReadOnly="True" Foreground="Blue" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="0" Grid.Column="3" Content="Air Distance:" FontWeight="Bold"/>
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.AirDistance, Mode=OneWay, StringFormat={}{0:F3}}" IsReadOnly="True" Style="{StaticResource NumericStyle}"/>

                                <Label Grid.Row="1" Grid.Column="3" Content="Actual Distance:" FontWeight="Bold"/>
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.ActualDistance, Mode=OneWay, StringFormat={}{0:F3}}" IsReadOnly="True" Style="{StaticResource NumericStyle}"/>

                                <Label Grid.Row="2" Grid.Column="3" Content="Open Time:" FontWeight="Bold"/>
                                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.OrderOpenTime, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="3" Grid.Column="3" Content="Start Time:" FontWeight="Bold"/>
                                <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.DeliveryStartTime, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="4" Grid.Column="3" Content="Expected:" FontWeight="Bold"/>
                                <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.ExpectedDeliveryTime, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="5" Grid.Column="3" Content="Max Time:" FontWeight="Bold"/>
                                <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.MaxDeliveryTime, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="6" Grid.Column="3" Content="Time Left:" FontWeight="Bold"/>
                                <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.TimeLeftToFinish, Mode=OneWay, StringFormat=\{0:dd\\.hh\\:mm\\:ss\}}" IsReadOnly="True" Foreground="Red" Style="{StaticResource ConfigTextBoxStyle}"/>

                                <Label Grid.Row="7" Grid.Column="3" Content="Schedule:" FontWeight="Bold"/>
                                <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding CurrentCourier.OrderInProgress.ScheduleStatus, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ConfigTextBoxStyle}"/>

                            </Grid>

                            <Button Content="Finish Delivery" Width="200" Margin="0,20,0,0"
                                    Style="{StaticResource ActionButtonStyle}" Background="#E67E22"
                                    Click="BtnFinishOrder_Click"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>