<Window x:Class="PL.Courier.CourierDirectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="CourierDirectWindow" Height="450" Width="800">
        

    <Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCourier.CourierId, Mode=TwoWay}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCourier.CourierFullName, Mode=TwoWay}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCourier.CourierCellPhone, Mode=TwoWay}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCourier.CourierEmail, Mode=TwoWay}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCourier.CourierPassword, Mode=TwoWay}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCourier.CourierIsActive, Mode=TwoWay}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentCourier.CourierLocation, Mode=TwoWay}"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentCourier.MaxCourierDistance, Mode=TwoWay}"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding CurrentCourier.VehicleType, Mode=TwoWay}"/>
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding CurrentCourier.StartWorkDate, Mode=TwoWay}"/>
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding CurrentCourier.TotalOnTimeDeliveries, Mode=TwoWay}"/>
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding CurrentCourier.TotalLateDeliveries, Mode=TwoWay}"/>

                <Button Grid.Row="12" Grid.Column="1" Content="Update" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Button_Click"/>

                <Grid Grid.Row="13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding CurrentCourier.OrderInProgress, Mode=OneWay}"/>
                    <TextBox Grid.Row="0" Text="{Binding CurrentCourier.OrderInProgress, Mode=OneWay}"/>


                </Grid>
                

            </Grid>
        </ScrollViewer>
    </Grid>

</Window>
