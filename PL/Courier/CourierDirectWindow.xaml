<Window x:Class="PL.Courier.CourierDirectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:converters="clr-namespace:PL.Converters"
        xmlns:Controls="clr-namespace:PL.Controls"
        mc:Ignorable="d"
        Title="Courier Dashboard" Height="700" Width="1000"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <TextBlock Text="COURIER" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="20" FontWeight="Light"/>
                    <TextBlock Text="PORTAL" Foreground="White" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
                    <Separator Margin="20,10" Opacity="0.3"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Current Status:" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <Border x:Name="StatusBadge" CornerRadius="10" Background="Gray" Padding="15,5" Margin="0,5">
                        <TextBlock x:Name="txtStatus" Text="Loading..." Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource BtnLogout}"
                        Margin="20" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" IsExitProgram="True" BackButtonVisibility="Collapsed"/>

            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="My Profile &amp; Statistics" Foreground="#3498DB" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <Controls:LabeledTextBox Label="ID:" 
                                                             Text="{Binding CurrentCourier.CourierId}" 
                                                             IsReadOnly="True" 
                                                             InputStyle="{StaticResource NumericStyle}"/>

                                    <Controls:LabeledTextBox Label="Full Name:" 
                                                             Text="{Binding CurrentCourier.CourierFullName}"/>

                                    <Controls:LabeledTextBox Label="Phone:"
                                                             Text="{Binding CurrentCourier.CourierCellPhone}"
                                                             InputStyle="{StaticResource NumericStyle}"/>

                                    <Controls:LabeledTextBox Label="Email:"
                                                             Text="{Binding CurrentCourier.CourierEmail}"/>

                                    <Controls:LabeledTextBox Label="Password:"
                                                             Text="{Binding CurrentCourier.CourierPassword}"/>

                                    <Controls:LabeledTextBox Label="Start Date:"
                                                             Text="{Binding CurrentCourier.StartWorkDate}"
                                                             IsReadOnly="True"/>
                                    
                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <Controls:LabeledTextBox Label="Active User:"
                                                             Text="{Binding CurrentCourier.CourierIsActive}"
                                                             IsReadOnly="True"/>

                                    <Controls:LabeledTextBox Label="Location:"
                                                             Text="{Binding CurrentCourier.CourierLocation}"/>

                                    <Controls:LabeledTextBox Label="Max Distance:"
                                                             Text="{Binding CurrentCourier.MaxCourierDistance}"
                                                             InputStyle="{StaticResource NumericStyle}"/>

                                    <Controls:LabeledComboBox x:Name="cmbVehicle"
                                                              Label="Vehicle Type:"
                                                              ItemsSource="{Binding VehicleTypesList}"
                                                              SelectedItem="{Binding CurrentCourier.VehicleType}"/>

                                    <Controls:LabeledTextBox Label="On-Time Deliveries:"
                                                             Text="{Binding CurrentCourier.TotalOnTimeDeliveries}"
                                                             IsReadOnly="True"
                                                             TextForeground="Green"/>

                                    <Controls:LabeledTextBox Label="Late Deliveries:"
                                                             Text="{Binding CurrentCourier.TotalLateDeliveries}"
                                                             IsReadOnly="True"
                                                             TextForeground="Red"/>

                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" Content="Update Profile" Width="200" Margin="0,15" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButtonStyle}" Click="BtnUpdate_Click"/>

                    <Grid Grid.Row="2" Margin="0,20,0,0">

                        <Border x:Name="pnlNoOrder" Background="#F9F9F9" BorderBrush="Gray" BorderThickness="1,1,1,1" CornerRadius="10" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Ready for next mission?" FontSize="20" Foreground="Gray" Margin="0,0,0,20"/>
                                <Button Content="Pick New Order" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Click="BtnPickOrder_Click"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="pnlHasOrder" Background="#FFF8E1" BorderBrush="#F39C12" BorderThickness="2" CornerRadius="10" Padding="20" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠ ACTIVE DELIVERY IN PROGRESS" Foreground="#E67E22" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <Controls:LabeledTextBox Label="Delivery ID:" 
                                                                Text="{Binding CurrentCourier.OrderInProgress.DeliveryId, Mode=OneWay}" 
                                                                IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Order ID:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.OrderId, Mode=OneWay}" 
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Type:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.TypeOfOrder, Mode=OneWay}" 
                                                                 IsReadOnly="True"
                                                                 InputStyle="{StaticResource EnumTextBoxStyle}"/>

                                        <Controls:LabeledTextBox Label="Details:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.OrderDetail, Mode=OneWay}" 
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Customer Name:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.CostumerFullName, Mode=OneWay}" 
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Address:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.CustomerAddress, Mode=OneWay}" 
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Phone:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.CostumerPhone, Mode=OneWay}" 
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Status:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.OrderStatus, Mode=OneWay}" 
                                                                 IsReadOnly="True"
                                                                 InputStyle="{StaticResource EnumTextBoxStyle}"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <Controls:LabeledTextBox Label="Air Distance:"
                                                                Text="{Binding CurrentCourier.OrderInProgress.AirDistance, Mode=OneWay, StringFormat={}{0:F3}}"
                                                                IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Actual Distance:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.ActualDistance, Mode=OneWay, StringFormat={}{0:F3}}"
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Open Time:"
                                                                Text="{Binding CurrentCourier.OrderInProgress.OrderOpenTime, Mode=OneWay}"
                                                                IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Start Time:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.DeliveryStartTime, Mode=OneWay}"
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Expected:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.ExpectedDeliveryTime, Mode=OneWay}"
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Max Time:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.MaxDeliveryTime, Mode=OneWay}"
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Time Left:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.TimeLeftToFinish, Mode=OneWay, StringFormat=\{0:dd\\.hh\\:mm\\:ss\}}"
                                                                 IsReadOnly="True"/>

                                        <Controls:LabeledTextBox Label="Schedule:"
                                                                 Text="{Binding CurrentCourier.OrderInProgress.ScheduleStatus, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 InputStyle="{StaticResource EnumTextBoxStyle}"/>
                                        
                                    </StackPanel>
                                </Grid>

                                <Button Content="Finish Delivery" Width="200" Margin="0,20,0,0"
                                    Style="{StaticResource ActionButtonStyle}" Background="#E67E22"
                                    Click="BtnFinishOrder_Click"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>