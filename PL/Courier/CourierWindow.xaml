<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Courier Details" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <TextBlock Text="COURIER" Foreground="#BDC3C7" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="PROFILE" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Row="2" 
                        Content="{Binding ActionButtonText}" 
                        Height="50" Margin="20"
                        Background="#27AE60" Foreground="White" 
                        FontSize="18" FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnAddUpdate_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Identity &amp; Contact" 
               Foreground="#3498DB" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextDecorations="Underline"/>

                <Label Grid.Row="1" Grid.Column="0" Content="ID Number:"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtId"
                         Text="{Binding CurrentCourier.CourierId, Mode=TwoWay}"
                         PreviewTextInput="NumberValidationTextBox" TextChanged="TxtId_TextChanged"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Full Name:"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding CurrentCourier.CourierFullName, Mode=TwoWay}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Email:"/>
                <TextBox Grid.Row="3" Grid.Column="1" 
                         Text="{Binding CurrentCourier.CourierEmail, Mode=TwoWay}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Cell Phone:"/>
                <TextBox Grid.Row="4" Grid.Column="1" 
                         Text="{Binding CurrentCourier.CourierCellPhone, Mode=TwoWay}"
                         PreviewTextInput="NumberValidationTextBox"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Password:"/>
                <TextBox Grid.Row="5" Grid.Column="1" 
                         Text="{Binding CurrentCourier.CourierPassword, Mode=TwoWay}"/>


                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Operational Details" 
               Foreground="#3498DB" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextDecorations="Underline"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Location:"/>
                <TextBox Grid.Row="8" Grid.Column="1" 
                         Text="{Binding CurrentCourier.CourierLocation, Mode=TwoWay}"/>

                <Label Grid.Row="9" Grid.Column="0" Content="Max Distance (km):"/>
                <TextBox Grid.Row="9" Grid.Column="1" 
                         Text="{Binding CurrentCourier.MaxCourierDistance, Mode=TwoWay}"/>

                <Label Grid.Row="10" Grid.Column="0" Content="Vehicle Type:"/>
                <ComboBox Grid.Row="10" Grid.Column="1" Height="28" Margin="0,4"
                          ItemsSource="{Binding VehicleTypesList}"
                          SelectedItem="{Binding CurrentCourier.VehicleType, Mode=TwoWay}"/>

                <Label Grid.Row="11" Grid.Column="0" Content="Start Date:"/>
                <DatePicker Grid.Row="11" Grid.Column="1"
                            SelectedDate="{Binding CurrentCourier.StartWorkDate, Mode=TwoWay}"
                            IsEnabled="False"/>

                <CheckBox Grid.Row="12" Grid.Column="1" Content="Is Active User"
                          IsChecked="{Binding CurrentCourier.CourierIsActive}"
                          Margin="0,10,0,0" FontWeight="Bold" VerticalAlignment="Center"/>


                <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Text="Statistics" 
                           Foreground="#95A5A6" FontWeight="Bold" FontSize="16" 
                           Margin="0,0,0,10" TextDecorations="Underline"/>

                <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Label Content="On Time:" Foreground="Gray"/>
                    <TextBlock Text="{Binding CurrentCourier.TotalOnTimeDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <Label Content="Late:" Foreground="Gray"/>
                    <TextBlock Text="{Binding CurrentCourier.TotalLateDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Foreground="Red"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>