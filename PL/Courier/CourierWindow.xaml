<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:PL.Controls"
        mc:Ignorable="d"
        Title="Courier Details"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <Label Content="COURIER" Style="{StaticResource StandardLabel}" Foreground="#BDC3C7"/>
                    <Label Content="PROFILE" Style="{StaticResource StandardLabel}"/>
                </StackPanel>

                <Button Grid.Row="2" 
                        Content="{Binding ActionButtonText}" 
                        Style="{StaticResource ActionButtonStyle}"
                        Width="200"
                        Margin="20" FontSize="18"
                        Click="BtnAddUpdate_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" BackButtonVisibility="Collapsed" Title="Courier Details"/>

            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30, 10, 30, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Identity &amp; Contact" 
                           Foreground="#3498DB" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextDecorations="Underline"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="ID Number:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtId" 
                         Text="{Binding CurrentCourier.CourierId, Mode=TwoWay}"
                         Style="{StaticResource NumericStyle}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Full Name:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding CurrentCourier.CourierFullName, Mode=TwoWay}"
                         Style="{StaticResource ConfigTextBoxStyle}"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Email:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding CurrentCourier.CourierEmail, Mode=TwoWay}" 
                         Style="{StaticResource ConfigTextBoxStyle}"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Cell Phone:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding CurrentCourier.CourierCellPhone, Mode=TwoWay}"
                         Style="{StaticResource NumericStyle}"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Password:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding CurrentCourier.CourierPassword, Mode=TwoWay}"
                         Style="{StaticResource ConfigTextBoxStyle}"/>


                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Operational Details"
                           Foreground="#3498DB" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextDecorations="Underline"/>

                    <Label Grid.Row="8" Grid.Column="0" Content="Location:" Style="{StaticResource ConfigLabelStyle}"/>
                    <TextBox Grid.Row="8" Grid.Column="1"
                         Text="{Binding CurrentCourier.CourierLocation, Mode=TwoWay}"
                         Style="{StaticResource ConfigTextBoxStyle}"/>

                    <Label Grid.Row="9" Grid.Column="0" Content="Max Distance (km):" Style="{StaticResource ConfigLabelStyle}" FontSize="12"/>
                    <TextBox Grid.Row="9" Grid.Column="1"
                         Text="{Binding CurrentCourier.MaxCourierDistance, Mode=TwoWay}"
                         Style="{StaticResource NumericStyle}"/>

                    <Label Grid.Row="10" Grid.Column="0" Content="Vehicle Type:" Style="{StaticResource ConfigLabelStyle}"/>
                    <ComboBox Grid.Row="10" Grid.Column="1"
                          ItemsSource="{Binding VehicleTypesList}"
                          SelectedItem="{Binding CurrentCourier.VehicleType, Mode=TwoWay}"
                          Style="{StaticResource ConfigComboBoxStyle}"/>

                    <Label Grid.Row="11" Grid.Column="0" Content="Start Date:" Style="{StaticResource ConfigLabelStyle}"/>
                    <DatePicker Grid.Row="11" Grid.Column="1" Margin="0,3"
                            SelectedDate="{Binding CurrentCourier.StartWorkDate, Mode=TwoWay}"
                            IsEnabled="False"/>

                    <CheckBox Grid.Row="12" Grid.Column="1" Content="Is Active User"
                          IsChecked="{Binding CurrentCourier.CourierIsActive}"
                          Margin="0,10,0,0" FontWeight="Bold" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Text="Statistics" 
                           Foreground="#3498DB" FontWeight="Bold" FontSize="16" 
                           Margin="0,0,0,10" TextDecorations="Underline"/>

                    <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Label Content="On Time:" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentCourier.TotalOnTimeDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Label Content="Late:" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentCourier.TotalLateDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Foreground="Red"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>