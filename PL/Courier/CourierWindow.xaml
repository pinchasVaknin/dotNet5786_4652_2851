<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:PL.Controls"
        mc:Ignorable="d"
        Title="Courier Details"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <Label Content="COURIER" Style="{StaticResource StandardLabel}" Foreground="#BDC3C7"/>
                    <Label Content="PROFILE" Style="{StaticResource StandardLabel}"/>
                </StackPanel>

                <Button Grid.Row="2" 
                        Content="{Binding ActionButtonText}" 
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="20" FontSize="18"
                        Click="BtnAddUpdate_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" BackButtonVisibility="Collapsed" Title="Courier Details"/>

            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <TextBlock Text="Identity &amp; Contact" Foreground="#3498DB" 
                               FontWeight="Bold" FontSize="16" Margin="0,0,0,15" 
                               TextDecorations="Underline"/>

                    <Controls:LabeledTextBox Label="ID Number:"
                                             Text="{Binding CurrentCourier.CourierId, Mode=TwoWay}"
                                             InputStyle="{StaticResource NumericStyle}"
                                             IsReadOnly="{Binding IsReadOnlyId}"/>

                    <Controls:LabeledTextBox Label="Full Name:"
                                             Text="{Binding CurrentCourier.CourierFullName, Mode=TwoWay}"/>

                    <Controls:LabeledTextBox Label="Email:"
                                             Text="{Binding CurrentCourier.CourierEmail, Mode=TwoWay}"/>

                    <Controls:LabeledTextBox Label="Cell Phone:"
                                             Text="{Binding CurrentCourier.CourierCellPhone, Mode=TwoWay}"
                                             InputStyle="{StaticResource NumericStyle}"/>

                    <Controls:LabeledTextBox Label="Password:"
                                             Text="{Binding CurrentCourier.CourierPassword, Mode=TwoWay}"/>

                    <TextBlock Text="Operational Details" Foreground="#3498DB" 
                               FontWeight="Bold" FontSize="16" Margin="0,15,0,15" 
                               TextDecorations="Underline"/>

                    <Controls:LabeledTextBox Label="Location:"
                                             Text="{Binding CurrentCourier.CourierLocation, Mode=TwoWay}"/>

                    <Controls:LabeledTextBox Label="Max Distance (Km):"
                                             Text="{Binding CurrentCourier.MaxCourierDistance, Mode=TwoWay}"
                                             InputStyle="{StaticResource NumericStyle}"/>

                    <Controls:LabeledComboBox Label="Vehicle Type:"
                                              ItemsSource="{Binding VehicleTypesList}"
                                              SelectedItem="{Binding CurrentCourier.VehicleType, Mode=TwoWay}"/>

                    <Controls:LabeledDatePicker Label="Start Date:"
                                                Date="{Binding CurrentCourier.StartWorkDate, Mode=TwoWay}"
                                                IsEnabled="False"/>

                    <CheckBox Content="Is Active User"
                              IsChecked="{Binding CurrentCourier.CourierIsActive}"
                              Margin="0,10,0,0" FontWeight="Bold" VerticalAlignment="Center"/>


                    <TextBlock Text="Statistics" Foreground="#3498DB" 
                               FontWeight="Bold" FontSize="16" Margin="0,15,0,15" 
                               TextDecorations="Underline"/>

                    <StackPanel Orientation="Horizontal">
                        <Label Content="On Time:" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentCourier.TotalOnTimeDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <Label Content="Late:" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentCourier.TotalLateDeliveries}" FontWeight="Bold" VerticalAlignment="Center" Foreground="Red"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>