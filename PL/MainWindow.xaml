<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        xmlns:Controls="clr-namespace:PL.Controls"
        mc:Ignorable="d"
        Title="MainWindow"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkBlueBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Delivery System"
                       Style="{StaticResource StandardLabel}"
                       FontSize="22" Margin="0,20,0,30"/>

                <StackPanel Grid.Row="1">
                    <Button Content="Couriers List" Click="BtnShowCouriers_Click" Style="{StaticResource ActionButtonBaseStyle}" FontSize="15"/>
                    <Button Content="Orders List" Click="BtnShowOrders_Click" Style="{StaticResource ActionButtonBaseStyle}" FontSize="15"/>
                </StackPanel>

                <Button Grid.Row="3" Style="{StaticResource BtnLogout}" Click="BtnLogout_Click"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <Label Content="Database Actions:" Foreground="LightGray" Margin="10,0"/>

                    <Button Content="Init DB" Background="{StaticResource LightBlueBrush}" Foreground="White" 
                            Click="BtnInitDB_Click" Style="{StaticResource ActionButtonBaseStyle}"/>

                    <Button Content="Reset DB" Background="{StaticResource RedBrush}" Foreground="White" 
                            Click="BtnResetDB_Click" Style="{StaticResource ActionButtonBaseStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" IsExitProgram="True" BackButtonVisibility="Collapsed"/>

            <Border Grid.Row="1" Background="#ECF0F1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0">
                        <Label Content="System Time:" FontSize="14" Foreground="Gray" Width="150" FontFamily="Segoe UI Black" Background="{x:Null}"/>
                        <Label Content="{Binding CurrentTime}" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource DarkBlueBrush}" FontFamily="Bodoni MT Black"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Label Content="Advance:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="+Min" Width="50" Height="35" Click="BtnAddMinute_Click" Style="{StaticResource ActionButtonBaseStyle}"/>
                        <Button Content="+Hour" Width="50" Height="35" Click="BtnAddHour_Click" Style="{StaticResource ActionButtonBaseStyle}"/>
                        <Button Content="+Day" Width="50" Height="35" Click="BtnAddDay_Click" Style="{StaticResource ActionButtonBaseStyle}"/>
                        <Button Content="+Year" Width="50" Height="35" Click="BtnAddYear_Click" Style="{StaticResource ActionButtonBaseStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="System Configuration" FontSize="18" Margin="0,0,0,15" 
                       BorderBrush="{StaticResource LightBlueBrush}" BorderThickness="0,0,0,2" FontFamily="Stencil">
                    <Label.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="White" Offset="0.318"/>
                        </LinearGradientBrush>
                    </Label.Background>
                </Label>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Controls:LabeledTextBox Grid.Row="0" 
                                                 Label="Company Address:" 
                                                 Text="{Binding Configuration.CompanyAddress}"/>

                        <Controls:LabeledTextBox Grid.Row="1" 
                                                 Label="Max Air Distance:"
                                                 Text="{Binding Configuration.MaxAirDistance}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="2"
                                                 Label="Avg Car Speed (km/h):"
                                                 Text="{Binding Configuration.AvgCarSpeed}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="3"
                                                 Label="Avg Motorcycle Speed (km/h):"
                                                 Text="{Binding Configuration.AvgMotorcycleSpeed}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="4"
                                                 Label="Avg Bicycle Speed (km/h):"
                                                 Text="{Binding Configuration.AvgBicycleSpeed}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="5"
                                                 Label="Avg Walking Speed (km/h):"
                                                 Text="{Binding Configuration.AvgWalkSpeed}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="6"
                                                 Label="Max Delivery Time:"
                                                 Text="{Binding Configuration.MaxDelTimeRnge}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="7"
                                                 Label="Risk Time Range:"
                                                 Text="{Binding Configuration.RiskTimeRnge}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Controls:LabeledTextBox Grid.Row="8"
                                                 Label="Inactive Time Range:"
                                                 Text="{Binding Configuration.UnactiveTimeRnge}"
                                                 InputStyle="{StaticResource NumericStyle}"/>

                        <Button Grid.Row="9"
                                Content="Save Configuration" 
                                HorizontalAlignment="Left" Height="35" Margin="0,20,0,0" 
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnUpdateConfig_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>