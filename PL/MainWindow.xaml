<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="MainWindow" Height="640" Width="850"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkBlueBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Delivery System"
                       Style="{StaticResource StandardLabel}"
                       FontSize="22" Margin="0,20,0,30"/>

                <StackPanel Grid.Row="1">
                    <Button Content="Couriers List" Click="BtnShowCouriers_Click" Style="{StaticResource MenuButtonStyle}" FontSize="15"/>
                    <Button Content="Orders List" Click="BtnShowOrders_Click" Style="{StaticResource MenuButtonStyle}" FontSize="15"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Label Content="Database Actions:" Foreground="LightGray" Margin="10,0"/>

                    <Button Content="Init DB" Background="{StaticResource LightBlueBrush}" Foreground="White" 
                            Click="BtnInitDB_Click" Style="{StaticResource ElephantButtonStyle}"/>

                    <Button Content="Reset DB" Background="{StaticResource RedBrush}" Foreground="White" 
                            Click="BtnResetDB_Click" Style="{StaticResource ElephantButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#ECF0F1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0">
                        <Label Content="System Time:" FontSize="14" Foreground="Gray" Width="150" FontFamily="Segoe UI Black" Background="{x:Null}"/>
                        <Label Content="{Binding CurrentTime}" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource DarkBlueBrush}" FontFamily="Bodoni MT Black"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Label Content="Advance:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="+Min" Width="50" Click="BtnAddMinute_Click" Style="{StaticResource ElephantButtonStyle}"/>
                        <Button Content="+Hour" Width="50" Click="BtnAddHour_Click" Style="{StaticResource ElephantButtonStyle}"/>
                        <Button Content="+Day" Width="50" Click="BtnAddDay_Click" Style="{StaticResource ElephantButtonStyle}"/>
                        <Button Content="+Year" Width="50" Click="BtnAddYear_Click" Style="{StaticResource ElephantButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="System Configuration" FontSize="18" Margin="0,0,0,15" 
                       BorderBrush="{StaticResource LightBlueBrush}" BorderThickness="0,0,0,2" FontFamily="Stencil">
                    <Label.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="White" Offset="0.318"/>
                        </LinearGradientBrush>
                    </Label.Background>
                </Label>

                <StackPanel Grid.Row="1">
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Company Address:" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding Configuration.CompanyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ConfigTextBoxStyle}"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Max Air Distance:" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding Configuration.MaxAirDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Avg Car Speed (km/h):" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding Configuration.AvgCarSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Avg Motorcycle Speed (km/h):" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding Configuration.AvgMotorcycleSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Avg Bicycle Speed (km/h):" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" 
                                 Text="{Binding Configuration.AvgBicycleSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Avg Walking Speed (km/h):" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" 
                                 Text="{Binding Configuration.AvgWalkSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Max Delivery Time:" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" 
                                 Text="{Binding Configuration.MaxDelTimeRnge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Risk Time Range:" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" 
                                 Text="{Binding Configuration.RiskTimeRnge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource NumericStyle}"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="Inactive Time Range:" Style="{StaticResource ConfigLabelStyle}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" 
                                 Text="{Binding Configuration.UnactiveTimeRnge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource NumericStyle}"/>

                        <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                                Content="Save Configuration" 
                                HorizontalAlignment="Left" Height="35" Margin="0,20,0,0" 
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnUpdateConfig_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>