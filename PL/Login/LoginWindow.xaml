<Window x:Class="PL.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Login"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="UserId" Style="{StaticResource ConfigTextBoxStyle}" Margin="0,131,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="Password" Style="{StaticResource ConfigTextBoxStyle}" RenderTransformOrigin="0.496,1.507" Margin="0,176,0,0" VerticalAlignment="Top"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="387,106,0,0" VerticalAlignment="Top" Click="Button_Click"/>
    </Grid>
</Window>
