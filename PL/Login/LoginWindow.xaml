<Window x:Class="PL.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivery System - Login" 
        Height="500" Width="700"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen"
        BorderBrush="{StaticResource DarkBlueBrush}" BorderThickness="1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkBlueBrush}">
            <Grid>

                <Image Source="/PL;component/Helpers/Image.ico"
                       Height="30" Width="30" 
                       Margin="10,10,0,0"
                       VerticalAlignment="Top" 
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Label Content="Delivery" Style="{StaticResource StandardLabel}" FontSize="24"/>
                    <Label Content="System" Style="{StaticResource StandardLabel}" FontSize="24"/>

                    <TextBlock Text="Secure Login" Foreground="LightGray" 
                               HorizontalAlignment="Center" Margin="0,20,0,0" 
                               FontFamily="Segoe UI" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Style="{StaticResource BtnExitProgram}"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40,0">

                <Label Content="Welcome" FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource DarkBlueBrush}" 
                       FontFamily="Elephant" Margin="0,0,0,20" 
                       HorizontalAlignment="Center"/>

                <Label Content="User ID:" Style="{StaticResource ConfigLabelStyle}"/>
                <TextBox x:Name="txtUserId" 
                         Style="{StaticResource NumericStyle}" 
                         TextChanged="ClearError_TextChanged"
                         KeyDown="HandleEnterKey"/>
                
                <TextBlock x:Name="ErrId" 
                           Text="Invalid User ID" 
                           Foreground="Red" FontSize="12" 
                           Visibility="Collapsed" Margin="2,0,0,0"/>


                <Label Content="Password:" Style="{StaticResource ConfigLabelStyle}" Margin="0,10,0,0"/>
                <PasswordBox x:Name="txtPassword" Height="25" 
                             VerticalContentAlignment="Center" 
                             Margin="0,3"
                             PasswordChanged="ClearError_PasswordChanged"
                             KeyDown="HandleEnterKey"/> 
                
                <TextBlock x:Name="ErrPass" 
                           Text="Password is required" 
                           Foreground="Red" FontSize="12" 
                           Visibility="Collapsed" Margin="2,0,0,0"/>

                <Button x:Name="btnLogin" Content="LOGIN" 
                        Style="{StaticResource ActionButtonStyle}" 
                        Width="200" Margin="0,30,0,0"
                        Click="BtnLogin_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>