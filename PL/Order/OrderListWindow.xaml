<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="OrderListWindow" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <!--External Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Internal, Upper Grid-->
        <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Label" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1" VerticalAlignment="Center" Height="30"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      FontWeight="Bold" FontSize="16" Foreground="Red" 
                      ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionKey}}" 
                      SelectedValue="{Binding VehicleFilter, Mode=TwoWay}" 
                      SelectionChanged="CourierFilter_SelectionChanged" Grid.ColumnSpan="2"/>
                      <!--ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"-->
                      <!--SelectedValue="{Binding OrderFilter, Mode=TwoWay}" SelectionChanged="OrderFilter_SelectionChanged"-->
            <ComboBox Grid.Column="2" VerticalAlignment="Center" Height="30"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      FontWeight="Bold" FontSize="16" Foreground="Red" 
                      ItemsSource="{Binding Source={StaticResource VehicleTypeCollectionKey}}" 
                      SelectedValue="{Binding VehicleFilter, Mode=TwoWay}" 
                      SelectionChanged="CourierFilter_SelectionChanged" Grid.ColumnSpan="2"/>   

        </Grid>
        <DataGrid Margin="5" Grid.Row="1" ItemsSource="{Binding OrderList}" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  AutoGenerateColumns="True" IsReadOnly="True"/>

        <Border Grid.Row="2" Background="#2C3E50">
            <Button Content="Add" Grid.Row="2" 
            HorizontalAlignment="Center" 
            Height="50" Width="100" 
            Background="#27AE60" 
            Foreground="White" 
            FontSize="16"/>
        </Border>
    </Grid>
    
</Window>
