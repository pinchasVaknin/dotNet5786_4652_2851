<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:PL.Controls"
        mc:Ignorable="d"
        Title="Courier Details"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource StandardWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,40,0,0">
                    <Label Content="ORDER" Style="{StaticResource StandardLabel}" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <Label Content="PROFILE" Style="{StaticResource StandardLabel}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVis}}">
                    <Label Content="Current Status" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="14"/>
                    <Border CornerRadius="15" Padding="20,8" Margin="0,10" Background="{Binding CurrentOrder.OrderStatus, Converter={StaticResource EnumToColorConverter}}">
                        <TextBlock Text="{Binding CurrentOrder.OrderStatus}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentOrder.OrderId, StringFormat='ID: #{0}'}" 
                               Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5"
                               FontSize="15"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVis}}">

                    <Label Content="Current Schedule" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="14"/>
                    <Border CornerRadius="15" Padding="20,8" Margin="0,10" Background="{Binding CurrentOrder.ScheduleStatus, Converter={StaticResource EnumToColorConverter}}">
                        <TextBlock Text="{Binding CurrentOrder.ScheduleStatus}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <Button Grid.Row="3" 
                        Content="{Binding ActionButtonText}" 
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="20,0,20,40" Height="50" FontSize="16"
                        IsEnabled="{Binding IsEditable}"
                        Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" BackButtonVisibility="Collapsed" Title="Order Form" Margin="0,0,0,20"/>

            <GroupBox Grid.Row="1" Header="Customer Details" Margin="10,0,10,0" BorderBrush="#BDC3C7">
                <Grid Margin="10" IsEnabled="{Binding IsEditable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Controls:LabeledTextBox Label="Customer Name:" Text="{Binding CurrentOrder.CustomerFullName, Mode=TwoWay}"/>
                        <Controls:LabeledTextBox Label="Phone Number:" Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay}"
                                                 InputStyle="{StaticResource NumericStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Controls:LabeledTextBox Label="Address Of Order:" Text="{Binding CurrentOrder.OrderAddress, Mode=TwoWay}" VerticalContentAlignment="Top"/>
                        <Controls:LabeledTextBox Label="Open Time:" Text="{Binding CurrentOrder.OrderOpenTime, StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Items" BorderBrush="#BDC3C7" 
                      Margin="10" IsEnabled="{Binding IsEditable}">
                
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category (TypeOfOrder) -->
                        <ComboBox x:Name="CmbFilterCategory" Grid.Column="0" Margin="0,0,10,0" Height="36"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  SelectionChanged="CmbOrderCategory_SelectionChanged"/>

                        <!-- Model -->
                        <ComboBox x:Name="CmbProductModel" Grid.Column="1" Margin="0,0,10,0" Height="36"
                                  Style="{StaticResource StandardComboBoxStyle}"/>

                        <!-- Qty -->
                        <TextBox x:Name="TxtQuantity" Grid.Column="2" Height="36" Text="1" HorizontalContentAlignment="Center"
                                 Style="{StaticResource NumericStyle}"/>

                        <Button Content="Add Item" Grid.Column="3" Width="90"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnAddItem_Click"/>
                    </Grid>

                    <DataGrid x:Name="ItemsDataGrid" Grid.Row="1" ItemsSource="{Binding ItemsCollection}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="1*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Remove" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="-1"
                                                Background="#F39C12" Foreground="White"
                                                BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                Click="BtnRemoveItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Delete" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑"
                                                Background="#E74C3C" Foreground="White"
                                                BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                Click="BtnDeleteItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <Border Grid.Row="3" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Margin="10" Padding="15"
                    Visibility="{Binding IsUpdateMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5" IsEnabled="{Binding IsEditable}">
                        <Controls:LabeledTextBox Label="Size:" Text="{Binding CurrentOrder.OrderSize}" IsReadOnly="True"/>
                        <Controls:LabeledTextBox Label="Weight:" Text="{Binding CurrentOrder.OrderWeight}" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5" IsEnabled="{Binding IsEditable}">
                        <Controls:LabeledTextBox Label="Time Left:" Text="{Binding CurrentOrder.TimeRemaining}" IsReadOnly="True"/>
                        <Controls:LabeledTextBox Label="Air Distance (Km):" Text="{Binding CurrentOrder.AirDistance, StringFormat={}{0:N2}}" IsReadOnly="True"/>
                    </StackPanel>

                    <Button Grid.Column="3" 
                            Content="View&#x0a;Delivery&#x0a;History" 
                            Width="80" Height="80"
                            Margin="10,0,0,0"
                            Background="#34495E" Foreground="White"
                            Click="BtnViewDeliveries_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>