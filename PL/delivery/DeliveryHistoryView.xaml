<Window x:Class="PL.delivery.DeliveryHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.delivery"
        mc:Ignorable="d"
        Title="Delivery History" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tracking Timeline" 
                   FontSize="22" FontWeight="Bold" Foreground="#2C3E50" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TimelineList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,5,20">
                                <TextBlock Text="{Binding Time}" FontWeight="Bold" Foreground="#34495E" FontSize="14" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Date}" Foreground="#7F8C8D" FontSize="11" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Border Width="2" Background="#BDC3C7" HorizontalAlignment="Center" Margin="0,5,-0,-5"/>

                                <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,4,0,0" Stroke="White" StrokeThickness="2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#BDC3C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="15" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#7F8C8D" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Height="40" Margin="0,15,0,0"
                Background="#34495E" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="BtnClose_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>