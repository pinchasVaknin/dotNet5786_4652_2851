<Window x:Class="PL.delivery.OpenDeliveryListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:PL.Controls"
        xmlns:local="clr-namespace:PL.delivery"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Style="{StaticResource StandardWindow}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,40,0,0">
                <TextBlock Text="DELIVERY" Foreground="#BDC3C7" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="PORTAL" Foreground="White" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
                <Separator Margin="20,10" Opacity="0.3"/>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnAssign" 
                            Grid.Row="1"
                            Content="Assign Order" 
                            Margin="10,5" 
                            IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OpenNewDeliveryButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Controls:TopBarControl Grid.Row="0" BackButtonVisibility="Collapsed"/>

            <DataGrid x:Name="ItemsDataGrid" Grid.Row="1" 
                      ItemsSource="{Binding OrderList}"
                      SelectedItem="{Binding SelectedOrder}"
                      Style="{StaticResource StandardDataGridStyle}"
                      SelectionChanged="ItemsDataGrid_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding OrderId}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeOfOrder}" CellStyle="{StaticResource EnumDataGridCellStyle}" Width="*"/>
                    <DataGridTextColumn Header="Weight" Binding="{Binding OrderWeight, StringFormat={}{0:N2} Kg}" Width="*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding OrderSize, StringFormat={}{0:N2} L}" Width="*" />
                    <DataGridTextColumn Header="Address" Binding="{Binding CustomerAddress}" Width="*"/>
                    <DataGridTextColumn Header="Distance" Binding="{Binding ActualDistance, StringFormat={}{0:N2} Km}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding ScheduleStatus}" Width="*"/>
                    <DataGridTextColumn Header="TimeLeft" Binding="{Binding TimeLeftToFinish}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
